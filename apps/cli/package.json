{
  "name": "@forge/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Build, print and export Forge workout plans from the terminal.",
  "type": "module",
  "bin": {
    "forge": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/bin.ts",
    "build": "tsup",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@forge/export": "workspace:*",
    "@forge/planner": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^22.0.0",
    "eslint": "^9",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.0"
  }
}
